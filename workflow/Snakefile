# project-blue-sea antigen discovery workflow.
#
# Three stages, split by what the cluster allows rather than by preference:
#
#   1. deterministic tools on compute nodes, no outbound network
#   2. the API stage, on a node that has network, reading stage 1 from disk
#   3. assembly, ranking and dossiers, deterministic again
#
# Per-protein work parallelises trivially and runs as SLURM array jobs; see
# workflow/profiles/slurm/config.yaml.
#
# The benchmark is a gate, not a report. `snakemake gate` must pass before
# `snakemake all` is worth running.

import os

configfile: "config/config.yaml"


SPECIES = list(config["species"])
REFERENCE = config["paths"]["reference"]
SCRATCH = config["paths"]["scratch"]
RESULTS = config["paths"]["results"]
HOST_PROTEOME = os.path.join(REFERENCE, config["host"]["proteome"])

# Shard counts for the per-protein predictors. Tune to the queue, not to the
# proteome: more shards means more jobs, not less work. `seqkit split2` numbers
# its parts from 001, so the shard ids do too.
N_SHARDS = config.get("n_shards", 50)
N_SHARDS_CANDIDATES = config.get("n_shards_candidates", 10)
SHARDS = [f"{i:03d}" for i in range(1, N_SHARDS + 1)]

CONTAINER = "containers/bluesea.sif"

# Every proteome the run needs, keyed by the directory it lands in. The host
# is in its own config section but is fetched and indexed exactly like the
# louse proteomes, so it joins them here.
HOST_DIR = os.path.dirname(config["host"]["proteome"])
GENOMES = {
    name: (cfg["accession"], cfg["assembly"])
    for name, cfg in config["species"].items()
}
GENOMES[HOST_DIR] = (config["host"]["accession"], config["host"]["assembly"])


def ncbi_prefix(genome: str) -> str:
    """The NCBI FTP path for an assembly, up to the shared filename stem.

    Accession and assembly name both appear in the path, so a mismatched pair
    in config fails here with a 404 rather than silently fetching nothing.
    """
    accession, assembly = GENOMES[genome]
    bank, digits = accession.split("_")
    digits = digits.split(".")[0]
    triples = "/".join(digits[i : i + 3] for i in range(0, 9, 3))
    stem = f"{accession}_{assembly}"
    return f"https://ftp.ncbi.nlm.nih.gov/genomes/all/{bank}/{triples}/{stem}/{stem}"


# Without these, {a}_vs_{b}.tsv can split at the wrong underscore and the
# genome wildcard can swallow a path separator.
wildcard_constraints:
    species="|".join(config["species"]),
    genome="|".join(GENOMES),
    a="|".join(config["species"]),
    b="|".join(config["species"]),
    shard=r"\d+",

# `literature` is the one rule that needs outbound network. Declaring it local
# keeps it off SLURM entirely: it runs on the host that invoked snakemake, a
# login node with outbound access, while every other rule is submitted to
# compute nodes that may have none. A resource constraint could not do this --
# it caps concurrency, it does not place a job.
#
# The two merges are local because they are `cat` and submitting them costs
# more in queue latency than running them. `orthology` is not: it parses both
# DIAMOND tables and rewrites every survivor record, which is real work and
# does not belong on a shared login node.
localrules:
    literature,
    download_proteome,
    download_gff,
    merge_topology,
    merge_candidate_predictions,


rule all:
    input:
        f"{RESULTS}/ranked_all.tsv",
        f"{RESULTS}/dossiers",
        f"{RESULTS}/provenance.json",


rule gate:
    """The six-week decision. Fails loudly if the rubric does not recover the
    known-working antigens on deterministic evidence alone."""
    input:
        f"{RESULTS}/benchmark.json",


rule provision:
    """Everything the run needs that can be fetched or built unattended.

    Not everything can. The expression matrices and the RNAi phenotype table
    come from LiceBase and the literature, not NCBI, and the container is
    built by scripts/build_container.sh because it cannot be built from
    inside itself. See docs/reference-data.md.
    """
    input:
        expand(f"{REFERENCE}/{{genome}}/proteins.faa", genome=GENOMES),
        expand(f"{REFERENCE}/{{genome}}/{{genome}}.dmnd", genome=GENOMES),
        # Annotations only for the louse species: the host proteome is a
        # search target, never a record set, so it needs no gene map.
        expand(f"{REFERENCE}/{{species}}/annotation.gff3", species=SPECIES),


# ---------------------------------------------------------------------------
# Stage 0 -- reference data
# ---------------------------------------------------------------------------


rule download_proteome:
    """Fetch one proteome from the NCBI assembly FTP.

    Local rule: it is network-bound, not compute-bound, and compute nodes are
    not assumed to have outbound access -- the same reason the literature
    stage runs here.
    """
    output:
        f"{REFERENCE}/{{genome}}/proteins.faa",
    params:
        url=lambda wc: f"{ncbi_prefix(wc.genome)}_protein.faa.gz",
    retries: 3
    shell:
        """
        curl -fsSL --retry 3 --retry-delay 5 -o {output}.gz {params.url}
        gunzip -c {output}.gz > {output}
        rm -f {output}.gz
        """


rule download_gff:
    """The annotation, for its protein-to-gene map and nothing else.

    NCBI protein FASTA headers carry no gene tag, so without this every
    protein is its own gene and the expression and RNAi tables -- the only
    evidence the essentiality axis has -- join to nothing.
    """
    output:
        f"{REFERENCE}/{{genome}}/annotation.gff3",
    params:
        url=lambda wc: f"{ncbi_prefix(wc.genome)}_genomic.gff.gz",
    retries: 3
    shell:
        """
        curl -fsSL --retry 3 --retry-delay 5 -o {output}.gz {params.url}
        gunzip -c {output}.gz > {output}
        rm -f {output}.gz
        """


rule diamond_db:
    input:
        f"{REFERENCE}/{{genome}}/proteins.faa",
    output:
        f"{REFERENCE}/{{genome}}/{{genome}}.dmnd",
    params:
        # DIAMOND appends .dmnd itself; handing it the full name would make
        # <genome>.dmnd.dmnd and the rule would fail on a missing output.
        base=lambda wc: f"{REFERENCE}/{wc.genome}/{wc.genome}",
    threads: 4
    resources:
        mem_mb=16000,
        runtime=60,
    container:
        CONTAINER
    shell:
        "diamond makedb --in {input} -d {params.base} --threads {threads}"


# ---------------------------------------------------------------------------
# Stage 1a -- topology, proteome-wide
#
# SignalP and DeepTMHMM have to see every protein, because the exposure filter
# is built on them and that filter is what decides who the expensive
# predictors get to skip.
# ---------------------------------------------------------------------------


rule shard_proteome:
    input:
        proteome=lambda wc: os.path.join(
            REFERENCE, config["species"][wc.species]["proteome"]
        ),
    output:
        # Named explicitly rather than as a directory: the proteome always has
        # far more sequences than shards, so the part list is known up front,
        # and Snakemake can then see which rule produces each shard.
        expand(f"{SCRATCH}/{{{{species}}}}/shards/part_{{shard}}.faa", shard=SHARDS),
    params:
        n=N_SHARDS,
        outdir=f"{SCRATCH}/{{species}}/shards",
    container:
        CONTAINER
    shell:
        """
        mkdir -p {params.outdir}
        seqkit split2 --by-part {params.n} --out-dir {params.outdir} {input.proteome}
        # seqkit names each part after the input file (proteins.part_001.faa);
        # downstream rules match on the shard number alone.
        for part in {params.outdir}/*.part_*; do
            mv "$part" "{params.outdir}/part_${{part##*.part_}}"
        done
        """


rule signalp:
    input:
        f"{SCRATCH}/{{species}}/shards/part_{{shard}}.faa",
    output:
        f"{SCRATCH}/{{species}}/signalp/{{shard}}.tsv",
    threads: 4
    resources:
        mem_mb=16000,
        runtime=120,
    container:
        CONTAINER
    shell:
        "signalp6 --fastafile {input} --organism eukarya --format none "
        "--output_dir $(dirname {output}) && "
        "mv $(dirname {output})/prediction_results.txt {output}"


rule deeptmhmm:
    input:
        f"{SCRATCH}/{{species}}/shards/part_{{shard}}.faa",
    output:
        f"{SCRATCH}/{{species}}/deeptmhmm/{{shard}}.gff3",
    threads: 4
    resources:
        mem_mb=16000,
        runtime=180,
    container:
        CONTAINER
    shell:
        "biolib run DTU/DeepTMHMM --fasta {input} --out-dir $(dirname {output}) && "
        "mv $(dirname {output})/predicted_topologies.3line {output}"


rule merge_topology:
    input:
        signalp=expand(
            f"{SCRATCH}/{{{{species}}}}/signalp/{{shard}}.tsv", shard=SHARDS
        ),
        tmhmm=expand(
            f"{SCRATCH}/{{{{species}}}}/deeptmhmm/{{shard}}.gff3", shard=SHARDS
        ),
    output:
        signalp=f"{SCRATCH}/{{species}}/signalp.tsv",
        tmhmm=f"{SCRATCH}/{{species}}/deeptmhmm.gff3",
    shell:
        """
        cat {input.signalp} > {output.signalp}
        cat {input.tmhmm} > {output.tmhmm}
        """


# ---------------------------------------------------------------------------
# Stage 1b -- the prefilter, and the predictors that run behind it
#
# This is the split that makes the README's claim true: epitope prediction and
# the salmon homology search only ever see proteins that passed length,
# low-complexity and exposure. Exposure alone cuts about eight in nine, so
# these two rules do roughly a ninth of the work they used to.
# ---------------------------------------------------------------------------


rule prefilter:
    input:
        signalp=f"{SCRATCH}/{{species}}/signalp.tsv",
        tmhmm=f"{SCRATCH}/{{species}}/deeptmhmm.gff3",
        proteome=lambda wc: os.path.join(
            REFERENCE, config["species"][wc.species]["proteome"]
        ),
        gff=lambda wc: os.path.join(
            REFERENCE, config["species"][wc.species]["gff"]
        ),
    output:
        records=f"{SCRATCH}/{{species}}/prefiltered.json",
        candidates=f"{SCRATCH}/{{species}}/candidates.faa",
    resources:
        mem_mb=8000,
        runtime=60,
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml prefilter --species {wildcards.species}"


checkpoint shard_candidates:
    """A checkpoint in earnest: how many proteins clear the prefilter is not
    known until it has run, so the shard list cannot be built in advance."""
    input:
        f"{SCRATCH}/{{species}}/candidates.faa",
    output:
        directory(f"{SCRATCH}/{{species}}/candidate_shards"),
    params:
        n=N_SHARDS_CANDIDATES,
    container:
        CONTAINER
    shell:
        """
        mkdir -p {output}
        seqkit split2 --by-part {params.n} --out-dir {output} {input}
        for part in {output}/*.part_*; do
            mv "$part" "{output}/part_${{part##*.part_}}"
        done
        """


rule epitopes:
    input:
        f"{SCRATCH}/{{species}}/candidate_shards/part_{{shard}}.faa",
    output:
        f"{SCRATCH}/{{species}}/epitopes/{{shard}}.tsv",
    threads: 2
    resources:
        mem_mb=8000,
        runtime=120,
    container:
        CONTAINER
    shell:
        "bepipred3 -i {input} -o {output} --threshold "
        f"{config['cascade']['epitope']['min_epitope_score']}"


rule host_blast:
    """Cross-reactivity screen against the salmon proteome.

    Sensitive mode on purpose: a missed salmon homolog is a candidate that
    should never have survived, which is far worse here than a slow search.
    Restricting it to prefilter survivors misses nothing -- a protein with no
    route to host antibody is already excluded on that ground.
    """
    input:
        query=f"{SCRATCH}/{{species}}/candidate_shards/part_{{shard}}.faa",
        db=f"{REFERENCE}/ssal/ssal.dmnd",
    output:
        f"{SCRATCH}/{{species}}/vs_host/{{shard}}.tsv",
    threads: 8
    resources:
        mem_mb=32000,
        runtime=240,
    container:
        CONTAINER
    shell:
        "diamond blastp --very-sensitive -q {input.query} -d {input.db} "
        "-o {output} --outfmt 6 --max-target-seqs 5 --threads {threads} "
        f"--evalue {config['cascade']['host_similarity']['max_evalue']}"


def candidate_shards(wildcards, subdir, extension):
    """Expand over the shards the prefilter actually produced."""
    shard_dir = checkpoints.shard_candidates.get(species=wildcards.species).output[0]
    shards = glob_wildcards(os.path.join(shard_dir, "part_{shard}.faa")).shard
    return expand(
        f"{SCRATCH}/{{species}}/{subdir}/{{shard}}.{extension}",
        species=wildcards.species,
        shard=sorted(shards),
    )


rule merge_candidate_predictions:
    input:
        epitopes=lambda wc: candidate_shards(wc, "epitopes", "tsv"),
        host=lambda wc: candidate_shards(wc, "vs_host", "tsv"),
    output:
        epitopes=f"{SCRATCH}/{{species}}/epitopes.tsv",
        host=f"{SCRATCH}/{{species}}/vs_host.tsv",
    shell:
        """
        head -n 1 {input.epitopes[0]} > {output.epitopes}
        tail -q -n +2 {input.epitopes} >> {output.epitopes}
        cat {input.host} > {output.host}
        """


rule assemble:
    input:
        records=f"{SCRATCH}/{{species}}/prefiltered.json",
        epitopes=f"{SCRATCH}/{{species}}/epitopes.tsv",
        host=f"{SCRATCH}/{{species}}/vs_host.tsv",
    output:
        f"{SCRATCH}/{{species}}/assembled.json",
    resources:
        mem_mb=8000,
        runtime=60,
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml assemble --species {wildcards.species}"


rule cascade:
    input:
        f"{SCRATCH}/{{species}}/assembled.json",
    output:
        cascaded=f"{SCRATCH}/{{species}}/cascaded.json",
        survivors=f"{SCRATCH}/{{species}}/survivors.json",
        summary=f"{RESULTS}/{{species}}/cascade_summary.tsv",
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml cascade --species {wildcards.species}"


rule cross_species_blast:
    input:
        query=lambda wc: os.path.join(
            REFERENCE, config["species"][wc.a]["proteome"]
        ),
        db=lambda wc: f"{REFERENCE}/{wc.b}/{wc.b}.dmnd",
    output:
        f"{SCRATCH}/{{a}}_vs_{{b}}.tsv",
    threads: 8
    resources:
        mem_mb=32000,
        runtime=240,
    container:
        CONTAINER
    shell:
        "diamond blastp --very-sensitive -q {input.query} -d {input.db} "
        "-o {output} --outfmt 6 --max-target-seqs 5 --threads {threads}"


rule orthology:
    input:
        survivors=expand(f"{SCRATCH}/{{species}}/survivors.json", species=SPECIES),
        # Not `forward`/`reverse`: `reverse` is reserved by Snakemake.
        a_vs_b=f"{SCRATCH}/{SPECIES[0]}_vs_{SPECIES[1]}.tsv",
        b_vs_a=f"{SCRATCH}/{SPECIES[1]}_vs_{SPECIES[0]}.tsv",
    output:
        touch(f"{SCRATCH}/orthology.done"),
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml orthology"


# ---------------------------------------------------------------------------
# Stage 2 -- API calls. Needs outbound network; runs off the compute nodes.
# ---------------------------------------------------------------------------


rule literature:
    """Dry run by default, which is what any config change should get first.

    Set BLUESEA_LIVE=1 to spend. Every response is cached on a hash of the
    exact prompt, so a rerun re-spends nothing it has already paid for.
    """
    input:
        f"{SCRATCH}/orthology.done",
    output:
        f"{config['paths']['logs']}/llm_usage_{{species}}.json",
    resources:
        # Caps concurrent API jobs at one; see localrules above for how this
        # rule is kept off the compute nodes.
        network=1,
    params:
        live=lambda wc: "--live" if os.environ.get("BLUESEA_LIVE") == "1" else "",
        blinded=lambda wc: "--blinded" if os.environ.get("BLUESEA_BLINDED") == "1" else "",
    shell:
        "bluesea --config config/config.yaml literature "
        "--species {wildcards.species} {params.live} {params.blinded}"


# ---------------------------------------------------------------------------
# Stage 3 -- scoring, ranking, dossiers
# ---------------------------------------------------------------------------


rule rank:
    input:
        expand(
            f"{config['paths']['logs']}/llm_usage_{{species}}.json", species=SPECIES
        ),
    output:
        ranking=f"{RESULTS}/ranked_all.tsv",
        provenance=f"{RESULTS}/provenance.json",
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml --weights config/weights.yaml rank"


rule dossiers:
    input:
        f"{RESULTS}/ranked_all.tsv",
    output:
        directory(f"{RESULTS}/dossiers"),
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml --weights config/weights.yaml dossiers"


rule benchmark:
    input:
        expand(f"{SCRATCH}/{{species}}/cascaded.json", species=SPECIES),
    output:
        f"{RESULTS}/benchmark.json",
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml --weights config/weights.yaml benchmark"


rule symbiont_gate:
    """Go/no-go after MAG assembly. A no-go stops the track, and that negative
    result is the deliverable for this arm."""
    input:
        f"{SCRATCH}/symbiont/mags.json",
    output:
        f"{RESULTS}/symbiont_gate.json",
    container:
        CONTAINER
    shell:
        "bluesea --config config/config.yaml symbiont-gate --mags {input}"
