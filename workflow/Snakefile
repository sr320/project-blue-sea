# project-blue-sea antigen discovery workflow.
#
# Three stages, split by what the cluster allows rather than by preference:
#
#   1. deterministic tools on compute nodes, no outbound network
#   2. the API stage, on a node that has network, reading stage 1 from disk
#   3. assembly, ranking and dossiers, deterministic again
#
# Per-protein work parallelises trivially and runs as SLURM array jobs; see
# workflow/profiles/slurm/config.yaml.
#
# The benchmark is a gate, not a report. `snakemake gate` must pass before
# `snakemake all` is worth running.

import os
import json
import yaml
from pathlib import Path

configfile: "config/config.yaml"


CONFIG_SOURCES = list(map(str, workflow.configfiles))
COMMON = list(dict.fromkeys([*map(str, workflow.configfiles), "config/weights.yaml",
                            *(["containers/bluesea.sif"] if Path("containers/bluesea.sif").exists() else []),
                            *map(str, Path("src/bluesea").glob("*.py"))]))
CONTROL_FILES = [config["validation"][k] for k in
                 ["positive_controls", "negative_controls", "construct_controls"]
                 if config["validation"].get(k)]
def literature_inputs(wc):
    packets = config.get("literature_sources", [])
    snapshots = [str(Path(path).parent / source["snapshot_path"])
                 for path in packets for source in json.loads(Path(path).read_text())]
    return [*packets, *snapshots]


if config["validation"].get("construct_controls"):
    registry = json.loads(Path(config["validation"]["construct_controls"]).read_text())
    CONTROL_FILES.extend(c["sequence_file"] for c in registry["constructs"] if c.get("sequence_file"))


SPECIES = list(config["species"])
ROOT = config.get("workdir", ".")
REFERENCE = os.path.normpath(os.path.join(ROOT, config["paths"]["reference"]))
SCRATCH = os.path.normpath(os.path.join(ROOT, config["paths"]["scratch"]))
RESULTS = os.path.normpath(os.path.join(ROOT, config["paths"]["results"]))
LOGS = os.path.normpath(os.path.join(ROOT, config["paths"]["logs"]))
CONFIG = os.path.join(SCRATCH, "resolved_config.yaml")
COMMON.append(CONFIG)
HOST_PROTEOME = os.path.join(REFERENCE, config["host"]["proteome"])

# Shard counts cap parallel jobs. Checkpoints handle fewer proteins than
# requested shards; the Python sharder numbers parts from 001.
N_SHARDS = config.get("n_shards", 50)
N_SHARDS_CANDIDATES = config.get("n_shards_candidates", 10)

CONTAINER = "containers/bluesea.sif"

# Every proteome the run needs, keyed by the directory it lands in. The host
# is in its own config section but is fetched and indexed exactly like the
# louse proteomes, so it joins them here.
HOST_DIR = os.path.dirname(config["host"]["proteome"])
GENOMES = {
    name: (cfg["accession"], cfg["assembly"])
    for name, cfg in config["species"].items()
}
GENOMES[HOST_DIR] = (config["host"]["accession"], config["host"]["assembly"])


def ncbi_prefix(genome: str) -> str:
    """The NCBI FTP path for an assembly, up to the shared filename stem.

    Accession and assembly name both appear in the path, so a mismatched pair
    in config fails here with a 404 rather than silently fetching nothing.
    """
    accession, assembly = GENOMES[genome]
    bank, digits = accession.split("_")
    digits = digits.split(".")[0]
    triples = "/".join(digits[i : i + 3] for i in range(0, 9, 3))
    stem = f"{accession}_{assembly}"
    return f"https://ftp.ncbi.nlm.nih.gov/genomes/all/{bank}/{triples}/{stem}/{stem}"


# Without these, {a}_vs_{b}.tsv can split at the wrong underscore and the
# genome wildcard can swallow a path separator.
wildcard_constraints:
    species="|".join(config["species"]),
    genome="|".join(GENOMES),
    a="|".join(config["species"]),
    b="|".join(config["species"]),
    shard=r"\d+",

# `literature` is the one rule that needs outbound network. Declaring it local
# keeps it off SLURM entirely: it runs on the host that invoked snakemake, a
# login node with outbound access, while every other rule is submitted to
# compute nodes that may have none. A resource constraint could not do this --
# it caps concurrency, it does not place a job.
#
# The two merges are local because they are `cat` and submitting them costs
# more in queue latency than running them. `orthology` is not: it parses both
# DIAMOND tables and writes separate enriched records, which is real work and
# does not belong on a shared login node.
localrules:
    resolved_config,
    literature,
    download_proteome,
    download_gff,
    merge_topology,
    merge_candidate_predictions,


rule all:
    input:
        f"{RESULTS}/ranked_all.tsv",
        f"{RESULTS}/dossiers",
        f"{RESULTS}/provenance.json",
        f"{RESULTS}/ranking_sensitivity.json",
        f"{RESULTS}/benchmark.json",


rule gate:
    """The six-week decision. Fails loudly if the rubric does not recover the
    known-working antigens on deterministic evidence alone."""
    input:
        f"{RESULTS}/gate.passed",


rule provision:
    """Everything the run needs that can be fetched or built unattended.

    Not everything can. The expression matrices and the RNAi phenotype table
    come from LiceBase and the literature, not NCBI, and the container is
    built by scripts/build_container.sh because it cannot be built from
    inside itself. See docs/reference-data.md.
    """
    input:
        expand(f"{REFERENCE}/{{genome}}/proteins.faa", genome=GENOMES),
        expand(f"{REFERENCE}/{{genome}}/{{genome}}.dmnd", genome=GENOMES),
        # Annotations only for the louse species: the host proteome is a
        # search target, never a record set, so it needs no gene map.
        expand(f"{REFERENCE}/{{species}}/annotation.gff3", species=SPECIES),


# ---------------------------------------------------------------------------
# Stage 0 -- reference data
# ---------------------------------------------------------------------------


rule download_proteome:
    """Fetch one proteome from the NCBI assembly FTP.

    Local rule: it is network-bound, not compute-bound, and compute nodes are
    not assumed to have outbound access -- the same reason the literature
    stage runs here.
    """
    output:
        f"{REFERENCE}/{{genome}}/proteins.faa",
    params:
        url=lambda wc: f"{ncbi_prefix(wc.genome)}_protein.faa.gz",
    retries: 3
    shell:
        """
        curl -fsSL --retry 3 --retry-delay 5 -o {output:q}.gz {params.url:q}
        gunzip -c {output:q}.gz > {output:q}
        rm -f {output:q}.gz
        """


rule download_gff:
    """The annotation, for its protein-to-gene map and nothing else.

    NCBI protein FASTA headers carry no gene tag, so without this every
    protein is its own gene and the expression and RNAi tables -- the only
    evidence the essentiality axis has -- join to nothing.
    """
    output:
        f"{REFERENCE}/{{genome}}/annotation.gff3",
    params:
        url=lambda wc: f"{ncbi_prefix(wc.genome)}_genomic.gff.gz",
    retries: 3
    shell:
        """
        curl -fsSL --retry 3 --retry-delay 5 -o {output:q}.gz {params.url:q}
        gunzip -c {output:q}.gz > {output:q}
        rm -f {output:q}.gz
        """


rule diamond_db:
    input:
        f"{REFERENCE}/{{genome}}/proteins.faa",
    output:
        f"{REFERENCE}/{{genome}}/{{genome}}.dmnd",
    params:
        # DIAMOND appends .dmnd itself; handing it the full name would make
        # <genome>.dmnd.dmnd and the rule would fail on a missing output.
        base=lambda wc: f"{REFERENCE}/{wc.genome}/{wc.genome}",
    threads: 4
    resources:
        mem_mb=16000,
        runtime=60,
    container:
        CONTAINER
    shell:
        "diamond makedb --in {input:q} -d {params.base:q} --threads {threads}"


# Local model installation is checked before any predictor job is submitted.
rule resolved_config:
    input:
        CONFIG_SOURCES,
    output:
        CONFIG,
    params:
        snapshot=lambda wc: json.dumps(config, sort_keys=True, indent=2),
    run:
        # Preserve numeric types when handing Snakemake config to PyYAML.
        # JSON exponent syntax is otherwise parsed as strings by YAML 1.1.
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        Path(output[0]).write_text(yaml.safe_dump(json.loads(params.snapshot)))


rule tools_check:
    input:
        config=COMMON,
        models=[path for tool in config.get("predictors", {}).values()
                for path in tool.get("required_files", []) if os.path.isfile(path)],
    output:
        f"{SCRATCH}/tools.ready",
    container:
        CONTAINER
    shell:
        "python -m bluesea.predictors --config {CONFIG:q} --check --output {output:q}"


rule pilot_check:
    input:
        config=COMMON,
        controls=CONTROL_FILES,
        references=[os.path.join(REFERENCE, cfg[key]) for cfg in config["species"].values()
                    for key in ["proteome", "gff", "expression", "rnai", "secretome", "gpi"] if cfg.get(key)] + [HOST_PROTEOME],
        report=[config["screening"]["pilot_report"]] if config.get("screening", {}).get("mode") == "full" else [],
    output:
        touch(f"{SCRATCH}/pilot.approved"),
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} --weights config/weights.yaml verify-pilot"


rule prepare:
    input:
        config=COMMON,
        approval=f"{SCRATCH}/pilot.approved",
        proteome=lambda wc: os.path.join(REFERENCE, config["species"][wc.species]["proteome"]),
        host=HOST_PROTEOME,
        controls=CONTROL_FILES,
    output:
        fasta=f"{SCRATCH}/{{species}}/screen.faa",
        spikes=f"{SCRATCH}/{{species}}/host_spikes.json",
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} --weights config/weights.yaml prepare --species {wildcards.species}"


checkpoint shard_topology:
    input:
        fasta=f"{SCRATCH}/{{species}}/screen.faa",
        ready=f"{SCRATCH}/tools.ready",
        config=COMMON,
    output:
        directory(f"{SCRATCH}/{{species}}/shards"),
    container:
        CONTAINER
    shell:
        "python -m bluesea.shard --input {input.fasta:q} --output-dir {output:q} --n {N_SHARDS}"


def topology_parts(wc, tool, extension):
    path = checkpoints.shard_topology.get(species=wc.species).output[0]
    shards = sorted(glob_wildcards(os.path.join(path, "part_{shard}.faa")).shard)
    return expand(f"{SCRATCH}/{{species}}/{tool}/{{shard}}.{extension}", species=wc.species, shard=shards)


rule signalp:
    input:
        fasta=f"{SCRATCH}/{{species}}/shards/part_{{shard}}.faa",
        config=COMMON,
    output:
        table=f"{SCRATCH}/{{species}}/signalp/{{shard}}.tsv",
        raw=directory(f"{SCRATCH}/{{species}}/raw/signalp/{{shard}}"),
    threads: 4
    resources:
        mem_mb=16000,
        runtime=120,
    container:
        CONTAINER
    shell:
        "python -m bluesea.predictors --config {CONFIG:q} --tool signalp "
        "--fasta {input.fasta:q} --output {output.table:q} --raw-dir {output.raw:q} --threads {threads}"


rule deeptmhmm:
    input:
        fasta=f"{SCRATCH}/{{species}}/shards/part_{{shard}}.faa",
        config=COMMON,
    output:
        table=f"{SCRATCH}/{{species}}/deeptmhmm/{{shard}}.3line",
        raw=directory(f"{SCRATCH}/{{species}}/raw/deeptmhmm/{{shard}}"),
    threads: 4
    resources:
        mem_mb=16000,
        runtime=180,
    container:
        CONTAINER
    shell:
        "python -m bluesea.predictors --config {CONFIG:q} --tool deeptmhmm "
        "--fasta {input.fasta:q} --output {output.table:q} --raw-dir {output.raw:q} --threads {threads}"


rule merge_topology:
    input:
        signalp=lambda wc: topology_parts(wc, "signalp", "tsv"),
        tmhmm=lambda wc: topology_parts(wc, "deeptmhmm", "3line"),
    output:
        signalp=f"{SCRATCH}/{{species}}/signalp.tsv",
        tmhmm=f"{SCRATCH}/{{species}}/deeptmhmm.gff3",
    shell:
        "cat {input.signalp:q} > {output.signalp:q}; cat {input.tmhmm:q} > {output.tmhmm:q}"


rule prefilter:
    input:
        signalp=f"{SCRATCH}/{{species}}/signalp.tsv",
        tmhmm=f"{SCRATCH}/{{species}}/deeptmhmm.gff3",
        proteome=f"{SCRATCH}/{{species}}/screen.faa",
        gff=lambda wc: os.path.join(REFERENCE, config["species"][wc.species]["gff"]),
        evidence=lambda wc: [os.path.join(REFERENCE, config["species"][wc.species][key])
                             for key in ["secretome", "gpi"] if config["species"][wc.species].get(key)],
        config=COMMON,
    output:
        records=f"{SCRATCH}/{{species}}/prefiltered.json",
        candidates=f"{SCRATCH}/{{species}}/candidates.faa",
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} prefilter --species {wildcards.species}"


checkpoint shard_candidates:
    input:
        fasta=f"{SCRATCH}/{{species}}/candidates.faa",
        config=COMMON,
    output:
        directory(f"{SCRATCH}/{{species}}/candidate_shards"),
    container:
        CONTAINER
    shell:
        "python -m bluesea.shard --input {input.fasta:q} --output-dir {output:q} --n {N_SHARDS_CANDIDATES}"


rule epitopes:
    input:
        fasta=f"{SCRATCH}/{{species}}/candidate_shards/part_{{shard}}.faa",
        config=COMMON,
    output:
        table=f"{SCRATCH}/{{species}}/epitopes/{{shard}}.tsv",
        raw=directory(f"{SCRATCH}/{{species}}/raw/bepipred/{{shard}}"),
    threads: 2
    resources:
        mem_mb=16000,
        runtime=120,
    container:
        CONTAINER
    shell:
        "python -m bluesea.predictors --config {CONFIG:q} --tool bepipred "
        "--fasta {input.fasta:q} --output {output.table:q} --raw-dir {output.raw:q} --threads {threads}"


rule host_blast:
    input:
        query=f"{SCRATCH}/{{species}}/candidate_shards/part_{{shard}}.faa",
        db=f"{REFERENCE}/{HOST_DIR}/{HOST_DIR}.dmnd",
        config=COMMON,
    output:
        f"{SCRATCH}/{{species}}/vs_host/{{shard}}.tsv",
    threads: 8
    resources:
        mem_mb=32000,
        runtime=240,
    params:
        evalue=config["cascade"]["host_similarity"]["max_evalue"],
    container:
        CONTAINER
    shell:
        "diamond blastp --very-sensitive -q {input.query:q} -d {input.db:q} "
        "-o {output:q} --outfmt 6 --max-target-seqs 0 --threads {threads} --evalue {params.evalue}"


def candidate_parts(wc, tool):
    path = checkpoints.shard_candidates.get(species=wc.species).output[0]
    shards = sorted(glob_wildcards(os.path.join(path, "part_{shard}.faa")).shard)
    return expand(f"{SCRATCH}/{{species}}/{tool}/{{shard}}.tsv", species=wc.species, shard=shards)


rule merge_candidate_predictions:
    input:
        epitopes=lambda wc: candidate_parts(wc, "epitopes"),
        host=lambda wc: candidate_parts(wc, "vs_host"),
    output:
        epitopes=f"{SCRATCH}/{{species}}/epitopes.tsv",
        host=f"{SCRATCH}/{{species}}/vs_host.tsv",
    run:
        with open(output.epitopes, "w") as out:
            for index, path in enumerate(input.epitopes):
                with open(path) as handle:
                    header = next(handle)
                    if index == 0:
                        out.write(header)
                    out.write(handle.read())
        with open(output.host, "w") as out:
            for path in input.host:
                with open(path) as handle:
                    out.write(handle.read())


rule assemble:
    input:
        records=f"{SCRATCH}/{{species}}/prefiltered.json",
        epitopes=f"{SCRATCH}/{{species}}/epitopes.tsv",
        host=f"{SCRATCH}/{{species}}/vs_host.tsv",
        evidence=lambda wc: [os.path.join(REFERENCE, config["species"][wc.species][key])
                             for key in ["expression", "rnai"] if config["species"][wc.species].get(key)],
        config=COMMON,
    output:
        f"{SCRATCH}/{{species}}/assembled.json",
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} assemble --species {wildcards.species}"


rule cascade:
    input:
        records=f"{SCRATCH}/{{species}}/assembled.json",
        config=COMMON,
    output:
        cascaded=f"{SCRATCH}/{{species}}/cascaded.json",
        survivors=f"{SCRATCH}/{{species}}/survivors.json",
        summary=f"{RESULTS}/{{species}}/cascade_summary.tsv",
        audit=f"{LOGS}/{{species}}/cascade_audit.jsonl",
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} cascade --species {wildcards.species}"


rule cross_species_blast:
    input:
        query=lambda wc: os.path.join(REFERENCE, config["species"][wc.a]["proteome"]),
        db=lambda wc: f"{REFERENCE}/{wc.b}/{wc.b}.dmnd",
        config=COMMON,
    output:
        f"{SCRATCH}/{{a}}_vs_{{b}}.tsv",
    threads: 8
    resources:
        mem_mb=32000,
        runtime=240,
    container:
        CONTAINER
    shell:
        "diamond blastp --very-sensitive -q {input.query:q} -d {input.db:q} "
        "-o {output:q} --outfmt 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore qseq sseq "
        "--max-target-seqs 5 --threads {threads}"


rule orthology:
    input:
        records=expand(f"{SCRATCH}/{{species}}/cascaded.json", species=SPECIES),
        alignments=[f"{SCRATCH}/{a}_vs_{b}.tsv" for a in SPECIES for b in SPECIES if a != b],
        config=COMMON,
    output:
        expand(f"{SCRATCH}/{{species}}/orthologized.json", species=SPECIES),
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} orthology"


rule literature:
    input:
        records=f"{SCRATCH}/{{species}}/orthologized.json",
        config=COMMON,
        sources=literature_inputs,
    output:
        records=f"{SCRATCH}/{{species}}/assessed.json",
        usage=f"{LOGS}/llm_usage_{{species}}.json",
    resources:
        network=1,
    params:
        live="--live" if os.environ.get("BLUESEA_LIVE") == "1" else "",
    shell:
        "bluesea --config {CONFIG:q} literature --species {wildcards.species} {params.live}"


rule rank:
    input:
        records=expand(f"{SCRATCH}/{{species}}/assessed.json", species=SPECIES),
        config=COMMON,
    output:
        ranking=f"{RESULTS}/ranked_all.tsv",
        provenance=f"{RESULTS}/provenance.json",
        sensitivity=f"{RESULTS}/ranking_sensitivity.json",
        records=expand(f"{SCRATCH}/{{species}}/ranked.json", species=SPECIES),
        per_species=expand(f"{RESULTS}/{{species}}/ranked.tsv", species=SPECIES),
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} --weights config/weights.yaml rank"


rule dossiers:
    input:
        records=expand(f"{SCRATCH}/{{species}}/ranked.json", species=SPECIES),
        config=COMMON,
    output:
        directory(f"{RESULTS}/dossiers"),
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} --weights config/weights.yaml dossiers"


rule benchmark:
    input:
        records=expand(f"{SCRATCH}/{{species}}/orthologized.json", species=SPECIES),
        spikes=expand(f"{SCRATCH}/{{species}}/host_spikes.json", species=SPECIES),
        controls=CONTROL_FILES,
        config=COMMON,
    output:
        f"{RESULTS}/benchmark.json",
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} --weights config/weights.yaml benchmark --report-only"


rule gate_check:
    input:
        f"{RESULTS}/benchmark.json",
    output:
        touch(f"{RESULTS}/gate.passed"),
    container:
        CONTAINER
    shell:
        "bluesea check-gate --report {input:q}"


rule symbiont_gate:
    input:
        mags=f"{SCRATCH}/symbiont/mags.json",
        config=COMMON,
    output:
        f"{RESULTS}/symbiont_gate.json",
    container:
        CONTAINER
    shell:
        "bluesea --config {CONFIG:q} symbiont-gate --mags {input.mags:q}"
